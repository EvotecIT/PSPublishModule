{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evotec.xyz/powerforge.tool.schema.json",
  "title": "PowerForge Tool Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "assets"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "default": "EvotecIT/PSPublishModule"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{40}$"
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(osx|linux|win)-(arm64|x64)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256"],
          "properties": {
            "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.zip$" },
            "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
            "executableSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": 2 } },
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["commit"],
        "properties": {
          "assets": {
            "patternProperties": {
              "^(osx|linux|win)-(arm64|x64)$": {
                "required": ["sha256", "executableSha256"]
              }
            }
          }
        }
      }
    }
  ]
}
