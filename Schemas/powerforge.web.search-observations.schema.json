{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evotec.xyz/powerforge/web/search-observations/v2.json",
  "title": "PowerForge.Web Search Observation Batch",
  "description": "Portable structural schema for Search observation exchange. Cross-field semantic invariants are enforced by WebSearchObservationNormalizer during import.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "siteId",
    "collectedAtUtc",
    "sourceKind",
    "status",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "runId": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "siteId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "collectedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sourceKind": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": ["complete", "partial"]
    },
    "configurationHash": {
      "type": ["string", "null"]
    },
    "evidenceReference": {
      "type": ["string", "null"]
    },
    "collectionCoverage": {
      "$ref": "#/$defs/collectionCoverage"
    },
    "zeroDataConfirmed": {
      "type": "boolean",
      "default": false,
      "description": "True only when a successful provider request explicitly confirmed that the requested slice contained no rows."
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "x-powerforge-semanticConstraints": [
    {
      "expression": "schemaVersion=1 cannot contain collectionCoverage or zeroDataConfirmed",
      "enforcedBy": "PowerForge.Web.WebSearchObservationNormalizer"
    },
    {
      "expression": "complete batches require observations or zeroDataConfirmed=true; zeroDataConfirmed is invalid for partial or nonempty batches and requires complete collectionCoverage",
      "enforcedBy": "PowerForge.Web.WebSearchObservationNormalizer"
    },
    {
      "expression": "partial collectionCoverage requires failedDate and failureCategory; completedDates are the consecutive prefix before failedDate; observations belong only to completedDates or failedDate",
      "enforcedBy": "PowerForge.Web.WebSearchObservationNormalizer"
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": { "maximum": 1 }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["collectionCoverage"] },
            { "required": ["zeroDataConfirmed"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": { "minimum": 2 }
        }
      },
      "then": {
        "required": ["collectionCoverage"]
      }
    },
    {
      "if": {
        "properties": {
          "status": { "pattern": "^complete$" }
        },
        "required": ["status"]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "observations": { "minItems": 1 }
            }
          },
          {
            "required": ["zeroDataConfirmed"],
            "properties": {
              "zeroDataConfirmed": { "enum": [true] },
              "observations": { "maxItems": 0 }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "collectionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromDate", "throughDate", "completedDates"],
      "properties": {
        "fromDate": {
          "type": "string",
          "format": "date"
        },
        "throughDate": {
          "type": "string",
          "format": "date"
        },
        "searchType": {
          "type": ["string", "null"]
        },
        "completedDates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "failedDate": {
          "type": ["string", "null"],
          "format": "date"
        },
        "failureCategory": {
          "type": ["string", "null"]
        }
      }
    },
    "observation": {
      "type": "object",
      "$comment": "Draft 2020-12 cannot compare sibling numeric values. Import additionally enforces clicks <= impressions through WebSearchObservationNormalizer.",
      "x-powerforge-semanticConstraints": [
        {
          "expression": "clicks <= impressions",
          "enforcedBy": "PowerForge.Web.WebSearchObservationNormalizer"
        }
      ],
      "additionalProperties": false,
      "required": ["date", "clicks", "impressions"],
      "anyOf": [
        {
          "required": ["page"],
          "properties": {
            "page": {
              "type": "string",
              "format": "uri",
              "pattern": "^[hH][tT][tT][pP][sS]?://"
            }
          }
        },
        {
          "required": ["query"],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ],
      "properties": {
        "observationKey": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "siteId": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "page": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^\\s*$"
            },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^[hH][tT][tT][pP][sS]?://"
            }
          ]
        },
        "query": {
          "type": ["string", "null"]
        },
        "country": {
          "type": ["string", "null"]
        },
        "device": {
          "type": ["string", "null"]
        },
        "searchType": {
          "type": ["string", "null"]
        },
        "clicks": {
          "type": "integer",
          "minimum": 0
        },
        "impressions": {
          "type": "integer",
          "minimum": 0
        },
        "clickThroughRate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "averagePosition": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "evidenceReference": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
