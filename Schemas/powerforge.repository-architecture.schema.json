{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/powerforge.repository-architecture.schema.json",
  "title": "PowerForge repository architecture policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "workspaceValidationConfig": { "type": "string", "minLength": 1 },
    "workspaceValidationProfile": { "type": "string", "minLength": 1, "default": "architecture" },
    "globalImpactPaths": { "$ref": "#/$defs/stringArray" },
    "projectRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectRule" },
      "default": []
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" },
      "default": []
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "projectRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "allowedProjectReferences": { "$ref": "#/$defs/stringArray" },
        "requiredProjectReferences": { "$ref": "#/$defs/stringArray" },
        "forbiddenProjectReferences": { "$ref": "#/$defs/stringArray" },
        "allowedPackageReferences": { "$ref": "#/$defs/stringArray" },
        "requiredPackageReferences": { "$ref": "#/$defs/stringArray" },
        "forbiddenPackageReferences": { "$ref": "#/$defs/stringArray" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerProjects", "ownerPaths", "consumerProjects", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "ownerProjects": { "$ref": "#/$defs/stringArray" },
        "ownerPaths": { "$ref": "#/$defs/stringArray" },
        "consumerProjects": { "$ref": "#/$defs/stringArray" },
        "ignoredUsageProjects": { "$ref": "#/$defs/stringArray" },
        "usagePatterns": { "$ref": "#/$defs/stringArray" },
        "usagePathIncludes": { "$ref": "#/$defs/stringArray" },
        "usagePathExcludes": { "$ref": "#/$defs/stringArray" },
        "usagePatternCaseSensitive": { "type": "boolean", "default": true },
        "requireObservedConsumers": { "type": "boolean", "default": true },
        "requiredEvidenceKinds": { "$ref": "#/$defs/stringArray" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "stepId", "coversProjects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "stepId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "coversProjects": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
