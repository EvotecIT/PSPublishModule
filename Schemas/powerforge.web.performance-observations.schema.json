{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evotec.xyz/powerforge/web/performance-observations/v1.json",
  "title": "PowerForge.Web Performance Observation Batch",
  "description": "Portable structural schema for laboratory and field performance evidence. WebPerformanceObservationNormalizer enforces cross-field semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "siteId", "collectedAtUtc", "sourceKind", "status", "measurementKind", "targetKind", "targetUrl", "formFactor", "observations"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "runId": { "type": ["string", "null"], "minLength": 1 },
    "provider": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "siteId": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "collectedAtUtc": { "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "sourceKind": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "status": { "enum": ["complete", "partial"] },
    "measurementKind": { "enum": ["lab", "field"] },
    "targetKind": { "enum": ["url", "origin"] },
    "targetUrl": { "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://" },
    "formFactor": { "enum": ["all", "phone", "desktop", "tablet"] },
    "toolVersion": { "type": ["string", "null"] },
    "configurationHash": { "type": ["string", "null"] },
    "evidenceReference": { "type": ["string", "null"] },
    "zeroDataConfirmed": { "type": "boolean" },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
  },
  "x-powerforge-semanticConstraints": [
    {
      "expression": "lab evidence uses URL scope, phone or desktop form factor, no percentile/period/histogram, and never claims INP",
      "enforcedBy": "PowerForge.Web.WebPerformanceObservationNormalizer"
    },
    {
      "expression": "field evidence uses p75 values, a 28-day aggregation period, and provider histogram densities summing to one",
      "enforcedBy": "PowerForge.Web.WebPerformanceObservationNormalizer"
    },
    {
      "expression": "zeroDataConfirmed is valid only for a complete empty field batch and all numeric values must be finite",
      "enforcedBy": "PowerForge.Web.WebPerformanceObservationNormalizer"
    }
  ],
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit"],
      "properties": {
        "observationKey": { "type": ["string", "null"] },
        "metric": { "enum": ["performance-score", "first-contentful-paint", "largest-contentful-paint", "cumulative-layout-shift", "total-blocking-time", "speed-index", "interaction-to-next-paint", "time-to-first-byte"] },
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["milliseconds", "score", "unitless"] },
        "percentile": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "periodStartDate": { "type": ["string", "null"], "format": "date" },
        "periodEndDate": { "type": ["string", "null"], "format": "date" },
        "histogram": { "type": "array", "items": { "$ref": "#/$defs/histogramBin" } }
      }
    },
    "histogramBin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["density"],
      "properties": {
        "start": { "type": ["number", "null"], "minimum": 0 },
        "end": { "type": ["number", "null"], "minimum": 0 },
        "density": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
