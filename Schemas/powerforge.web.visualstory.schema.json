{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "powerforge.web.visualstory.schema.json",
  "title": "PowerForge Web Visual Story Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "alt", "outcome", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "alt": { "type": "string", "minLength": 1 },
    "caption": { "type": ["string", "null"] },
    "outcome": { "type": "string", "minLength": 1 },
    "generatedAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "producer": { "type": ["string", "null"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "const": "completed" }
        }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "format", "path"],
        "properties": {
          "role": { "enum": ["animated", "completed", "transcript", "source", "html"] },
          "format": { "enum": ["svg", "gif", "apng", "png", "html", "text", "txt"] },
          "path": { "type": "string", "minLength": 1 },
          "mediaType": { "type": ["string", "null"] },
          "bytes": { "type": ["integer", "null"], "minimum": 0 },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" }
        },
        "allOf": [
          {
            "if": {
              "required": ["role"],
              "properties": {
                "role": { "const": "completed" }
              }
            },
            "then": {
              "properties": {
                "format": { "const": "png" }
              }
            }
          }
        ]
      }
    }
  }
}
