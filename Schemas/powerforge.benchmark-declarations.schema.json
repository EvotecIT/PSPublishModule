{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/powerforge.benchmark-declarations.schema.json",
  "title": "PowerForge benchmark declarations (schema 5)",
  "description": "Library policy and comparison declarations. Maps to PowerForge.BenchmarkDeclarationDocument. Generate it from the benchmark code and check it with Test-BenchmarkDeclaration.",
  "type": "object",
  "required": ["schemaVersion", "libraries", "comparisons"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 5 },
    "libraries": {
      "type": "array",
      "items": { "$ref": "#/$defs/library" }
    },
    "comparisons": {
      "type": "array",
      "items": { "$ref": "#/$defs/comparison" }
    }
  },
  "$defs": {
    "restriction": {
      "description": "Licence restriction class.",
      "enum": ["open", "publish-restricted", "acceptance-required", "excluded"]
    },
    "library": {
      "type": "object",
      "required": ["id", "package", "version", "restriction"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Library id used by result cells and comparisons." },
        "package": { "type": "string", "minLength": 1, "description": "Package the library is measured from." },
        "version": { "type": "string", "minLength": 1, "pattern": "^[^\\[\\(\\*, ]+$", "description": "One pinned package version." },
        "license": { "type": "string", "description": "SPDX expression or LicenseRef-*." },
        "licenseUrl": { "type": "string" },
        "restriction": { "$ref": "#/$defs/restriction" },
        "reason": { "type": "string", "description": "Required for every class except open." }
      },
      "anyOf": [{ "required": ["license"] }, { "required": ["licenseUrl"] }],
      "if": { "properties": { "restriction": { "not": { "const": "open" } } } },
      "then": { "required": ["reason"], "properties": { "reason": { "minLength": 1 } } }
    },
    "axis": {
      "type": "object",
      "required": ["name", "values"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
      }
    },
    "cell": {
      "type": "object",
      "required": ["case"],
      "properties": {
        "case": { "type": "string", "minLength": 1, "pattern": "\\S", "description": "One of the comparison's declared cases; every cell names one." },
        "library": { "type": "string", "description": "Library id; empty or absent for every library of the comparison." },
        "parameters": {
          "type": "object",
          "description": "One declared value for every axis, keyed by axis name.",
          "additionalProperties": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["comparisonId", "area", "title", "subject", "libraries", "expectedPlatforms"],
      "properties": {
        "comparisonId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable id. Framework and affinity are lane dimensions and never part of it.",
          "not": { "pattern": "(-net\\d+(\\.\\d+)?|-netcoreapp\\d+\\.\\d+|-netstandard\\d+\\.\\d+)$|-affinity-" }
        },
        "area": { "type": "string", "minLength": 1 },
        "group": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "libraries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "axes": { "type": "array", "items": { "$ref": "#/$defs/axis" } },
        "cases": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" }, "uniqueItems": true, "description": "Case names the benchmark code defines. A comparison is published only when it declares its cases or cells." },
        "cells": {
          "type": "array",
          "description": "The case x library x axis-value cells the benchmark code defines, when not every combination is valid. Without it, every combination of the declared cases and axis values is expected for each library that ran.",
          "items": { "$ref": "#/$defs/cell" }
        },
        "expectedPlatforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "eligibility": {
          "type": "object",
          "properties": {
            "publishable": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        }
      }
    }
  }
}
