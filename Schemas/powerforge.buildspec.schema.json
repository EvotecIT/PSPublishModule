{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "powerforge.buildspec.schema.json",
  "title": "PowerForge ModuleBuildSpec (schema v1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },

    "Name": { "type": "string", "minLength": 1 },
    "SourcePath": { "type": "string", "minLength": 1 },
    "StagingPath": { "type": ["string", "null"] },
    "CsprojPath": { "type": ["string", "null"] },
    "SkipDotNetBuild": { "type": "boolean" },

    "Version": { "type": "string" },
    "PreReleaseTag": { "type": [ "string", "null" ] },
    "Configuration": { "type": "string" },
    "Frameworks": { "type": "array", "items": { "type": "string" } },

    "Author": { "type": ["string", "null"] },
    "CompanyName": { "type": ["string", "null"] },
    "Description": { "type": ["string", "null"] },
    "Tags": { "type": "array", "items": { "type": "string" } },
    "IconUri": { "type": ["string", "null"] },
    "ProjectUri": { "type": ["string", "null"] },

    "ExcludeDirectories": { "type": "array", "items": { "type": "string" } },
    "ExcludeFiles": { "type": "array", "items": { "type": "string" } },

    "ExportAssemblies": { "type": "array", "items": { "type": "string" } },
    "DisableBinaryCmdletScan": { "type": "boolean" },
    "IgnoreLibraryOnLoad": { "type": "array", "items": { "type": "string" } },
    "SharedAssemblies": { "type": "array", "default": [], "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" } },
    "PreloadSharedAssemblies": { "type": "array", "default": [], "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" } },
    "UseAssemblyLoadContext": { "type": "boolean" },
    "ReadyToRun": {
      "type": ["object", "null"],
      "description": "Opt-in precompiled PowerShell 7 payloads, one per runtime identifier, loaded instead of the portable build on a matching host.",
      "additionalProperties": false,
      "properties": {
        "Enabled": { "type": "boolean" },
        "Framework": { "type": "string", "description": "Target framework of the precompiled payloads; the binary project must target it. Defaults to net10.0." },
        "RuntimeIdentifiers": { "type": "array", "items": { "type": "string" }, "description": "Defaults to win-x64." },
        "Scope": { "type": "string", "enum": ["ModuleAssemblies", "All"], "description": "ModuleAssemblies precompiles the module project and its project references; All also precompiles NuGet package assemblies." }
      }
    },
    "DesktopDependencyAssetFrameworks": {
      "type": "object",
      "description": "Explicit NuGet package ID to Desktop asset TFM selections for .NET Framework 4.7.2 or later; Core assets are unchanged.",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "enum": ["netstandard2.0"] }
    },
    "DevelopmentBinariesMode": { "type": "string", "enum": ["Off", "Environment", "Auto"] },
    "DevelopmentBinariesPath": { "type": ["string", "null"] },
    "DevelopmentBinariesEnvironmentVariable": { "type": ["string", "null"] },
    "DevelopmentConfigurationEnvironmentVariable": { "type": ["string", "null"] },
    "DevelopmentSourceBootstrapperMode": { "type": "string", "enum": ["PreserveSingleFile", "ReplaceSingleFile"] },
    "AssemblyTypeAcceleratorMode": { "type": ["string", "null"], "enum": ["None", "AllowList", "Assembly", "Enums", null] },
    "AssemblyTypeAccelerators": { "type": "array", "items": { "type": "string" } },
    "AssemblyTypeAcceleratorAssemblies": { "type": "array", "items": { "type": "string" } },
    "KeepStaging": { "type": "boolean" },
    "PowerShellCompilation": {
      "anyOf": [
        { "$ref": "powerforge.common.schema.json#/$defs/PowerShellModuleCompilationConfiguration" },
        { "type": "null" }
      ]
    }
  },
  "required": ["Name", "SourcePath"]
}
