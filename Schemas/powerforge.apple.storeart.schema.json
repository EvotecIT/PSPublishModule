{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerForge Apple store art",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "theme",
    "locales",
    "devices",
    "frames"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "casaray",
            "tactra",
            "officeimo"
          ]
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "captionsPath": {
      "type": "string"
    },
    "captureRoot": {
      "type": "string"
    },
    "captures": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "iphone-69",
          "iphone-63",
          "duo-outer",
          "duo-inner",
          "ipad-13",
          "mac",
          "watch",
          "mac-1440"
        ]
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/frame"
      }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layout",
        "capture"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "capture": {
          "type": "string"
        },
        "watch": {
          "type": "string"
        },
        "headlineKey": {
          "type": "string"
        },
        "eyebrowKey": {
          "type": "string"
        },
        "sublineKey": {
          "type": "string"
        },
        "layout": {
          "enum": [
            "hero",
            "focus",
            "pair",
            "surfaces",
            "statement",
            "ipad",
            "mac",
            "watch"
          ]
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "iphone-69",
              "iphone-63",
              "duo-outer",
              "duo-inner",
              "ipad-13",
              "mac",
              "watch",
              "mac-1440"
            ]
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mood": {
          "enum": [
            "",
            "light",
            "dark"
          ]
        },
        "deviceWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 6000
        },
        "watchWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "island": {
          "type": "boolean"
        },
        "lens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rect"
          ],
          "properties": {
            "rect": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 8
            },
            "at": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "lift": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        }
      }
    }
  }
}
