{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "powerforge.dotnettests.schema.json",
  "title": "PowerForge .NET test profiles",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "projectRoot": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "configuration": {
            "type": "string"
          },
          "warningsAsErrors": {
            "type": "boolean",
            "default": true
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "default": 1200
          },
          "buildProjects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "frameworks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "testProjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nativeProjects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "executable": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "runEnvironments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "required": [
                "path",
                "executable"
              ],
              "additionalProperties": false
            }
          },
          "beforeTests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "DotNet",
                    "Command"
                  ]
                },
                "executable": {
                  "type": "string"
                },
                "arguments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "workingDirectory": {
                  "type": "string"
                },
                "environmentVariables": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "failureContext": {
                  "type": "string"
                },
                "failureHint": {
                  "type": "string"
                },
                "requiredPath": {
                  "type": "string"
                },
                "continueOnMissingRequiredPath": {
                  "type": "boolean"
                },
                "frameworks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "profiles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requiredFeatures": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "afterTests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "DotNet",
                    "Command"
                  ]
                },
                "executable": {
                  "type": "string"
                },
                "arguments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "workingDirectory": {
                  "type": "string"
                },
                "environmentVariables": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "failureContext": {
                  "type": "string"
                },
                "failureHint": {
                  "type": "string"
                },
                "requiredPath": {
                  "type": "string"
                },
                "continueOnMissingRequiredPath": {
                  "type": "boolean"
                },
                "frameworks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "profiles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requiredFeatures": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "environmentVariables": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profiles"
  ],
  "additionalProperties": false
}
