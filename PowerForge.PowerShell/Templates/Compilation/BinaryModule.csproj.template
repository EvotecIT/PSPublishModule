<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>{{TARGET_FRAMEWORK}}</TargetFramework>
    <AssemblyName>{{ARTIFACT_NAME}}</AssemblyName>
    <AssemblyVersion>{{ASSEMBLY_VERSION}}</AssemblyVersion>
    <FileVersion>{{ASSEMBLY_VERSION}}</FileVersion>
    <RootNamespace>PowerForge.Compiled</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    {{TARGET_REFERENCE}}
    {{POWERSHELL_REFERENCE}}
    {{PROVIDER_REFERENCES}}
  </ItemGroup>
</Project>
