# Root-owned, group-readable configuration for powerforge-service-artifact-pull.
# The matching /etc/powerforge/services/<service>.env supplies SERVICE_ROOT.
SOURCE_REPOSITORY=ExampleOrg/Service
SOURCE_BRANCH=main
SOURCE_WORKFLOW=package-service.yml
ARTIFACT_NAME=powerforge-service-example
WORK_ROOT=/var/lib/powerforge/service-pull/example
