# Root-owned configuration for /usr/local/sbin/powerforge-service-deploy.
SERVICE_ROOT=/srv/example/service
# Host-pull lane only: set this to WORK_ROOT/.stage from the matching pull configuration.
# Leave unset for the SSH push lane, which uses its existing /tmp handoff.
# ARTIFACT_PULL_STAGE_ROOT=/var/lib/powerforge/service-pull/example/.stage
SYSTEMD_SERVICE=example.service
# Optional, space-separated existing data directories that a ProtectSystem=strict unit may write.
SYSTEMD_READ_WRITE_PATHS="/var/lib/example-service"
LOCAL_HEALTH_URL=http://127.0.0.1:8080/healthz
PUBLIC_HEALTH_URLS="https://api.example.com/healthz https://api-alt.example.com/healthz"
REQUIRED_RELEASE_PATHS="package.json src/server.mjs"
RELEASES_TO_KEEP=5
REQUIRE_HEALTH_PROVENANCE=1
