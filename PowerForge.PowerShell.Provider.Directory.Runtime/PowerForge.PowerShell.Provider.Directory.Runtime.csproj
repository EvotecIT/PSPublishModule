<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <VersionPrefix>3.0.126</VersionPrefix>
    <PackageId>PowerForge.PowerShell.Provider.Directory.Runtime</PackageId>
    <Description>Executable win-x64 LDAP provider package for runtime-free PowerForge artifacts.</Description>
    <PackageTags>powershell;compiler;provider;ldap;directory;powerforge</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/EvotecIT/PSPublishModule</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerForge.PowerShell.Provider.Directory\PowerForge.PowerShell.Provider.Directory.csproj" />
    <ProjectReference Include="..\PowerForge.PowerShell.ProviderSdk\PowerForge.PowerShell.ProviderSdk.csproj" />
  </ItemGroup>

  <Target Name="ReplaceNuGetWithExecutableProviderPackage" AfterTargets="GenerateNuspec">
    <PropertyGroup>
      <ProviderPackageOutputPath>$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(PackageVersion).nupkg'))</ProviderPackageOutputPath>
    </PropertyGroup>
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectFullPath)&quot; --configuration $(Configuration) --no-build -- &quot;$(ProviderPackageOutputPath)&quot; &quot;$(PackageVersion)&quot;" />
  </Target>

</Project>
