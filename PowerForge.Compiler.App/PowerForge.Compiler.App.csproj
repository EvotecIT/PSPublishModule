<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
    <AssemblyName>PowerForgeCompiler</AssemblyName>
    <RootNamespace>PowerForge.Compiler.App</RootNamespace>
    <Description>Check and compile a PowerShell script or module with PowerForge.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <!-- Avalonia's build telemetry; keep it out of builds. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerForge.PowerShell\PowerForge.PowerShell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PowerForge.Compiler.App.Tests" />
  </ItemGroup>
</Project>
