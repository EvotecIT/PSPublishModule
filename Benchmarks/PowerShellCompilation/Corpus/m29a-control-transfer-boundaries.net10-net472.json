  "decision": {
    "ownership": "Retain authored source under PowerShell for cross-caller break and exit; do not map them to C# return or an ordinary catchable exception.",
    "invariants": [
      "break may target the caller loop and must preserve outer continuation",
      "break without a caller target may terminate the script",
      "exit skips catch and preserves finally while selecting script/host exit status",
      "generated Hybrid delivery must preserve the same retained source behavior"
    ],
    "reopeningRequirements": [
      "A reusable caller/control-flow ABI identifies scope boundaries and dynamic caller targets",
      "A non-error transfer propagates through native invocation without entering ordinary catch handlers",
      "finally, nested invocation, downstream stop and host-specific script/process exit behavior have real artifact proof",
      "Script packaging and module delivery use the same exit owner without unsafe exception rewriting"
    ]
  },
  "limits": [
    "Four complete authored sources execute only safe rejection paths; no normal formatting/drive/AD workflow claim.",
    "ConvertTo-WPFGrid and Out-More are source-inspected only; no GUI or interactive paging executes.",
    "The generated artifact contains one synthetic compiled marker to exercise mixed delivery; it is not counted as module/compiler workload coverage.",
    "These justified hosted boundaries do not implement general nonlocal transfer semantics or close all remaining support gaps."
  ]
}
