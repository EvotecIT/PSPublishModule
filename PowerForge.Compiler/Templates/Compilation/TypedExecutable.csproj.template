<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>{{TARGET_FRAMEWORK}}</TargetFramework>
    <AssemblyName>{{ARTIFACT_NAME}}</AssemblyName>
    <RootNamespace>PowerForge.Compiled</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap>
    <DebugType>portable</DebugType>
    <PublishSingleFile>{{SINGLE_FILE}}</PublishSingleFile>
    <SelfContained>{{SELF_CONTAINED}}</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>{{SINGLE_FILE}}</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>{{PUBLISH_TRIMMED}}</PublishTrimmed>
    <PublishAot>{{PUBLISH_AOT}}</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(PublishTrimmed)' == 'true' or '$(PublishAot)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">
    <!-- Preserve the native PDB without recording the temporary project path in the executable. -->
    <LinkerArg Include="/Brepro" />
    <LinkerArg Include="/PDBALTPATH:$(AssemblyName).pdb" />
  </ItemGroup>
  <ItemGroup>
    {{PROVIDER_REFERENCES}}
  </ItemGroup>
</Project>
