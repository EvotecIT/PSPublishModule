name: Private Apple capture

on:
  workflow_dispatch:
    inputs:
      source_ref:
        description: Qualified merged application commit
        type: string
        required: true
      marketing_version:
        description: App Store version represented by the images
        type: string
        required: true

permissions:
  contents: read
  actions: read

jobs:
  capture:
    uses: EvotecIT/PSPublishModule/.github/workflows/powerforge-apple-private-screenshot-capture.yml@__REVIEWED_OWNER_COMMIT__
    with:
      # These are enrolled policy, not dispatch inputs.
      source_repository: example/public-app
      source_branch: master
      qualification_workflow: .github/workflows/apple-ci.yml
      required_checks_json: '["Native Apple qualification"]'
      source_ref: ${{ inputs.source_ref }}
      marketing_version: ${{ inputs.marketing_version }}
      capture_script: Build/Apple/Capture-Screenshots.ps1
      capture_shell: pwsh
      capture_artifact_path: Artifacts/Apple/screenshots
      runner_group: private-apple-capture
      runner_labels_json: '["private-apple-capture"]'
      simulator_devices_json: '{"iphone":"__OWNED_IPHONE_UUID__","ipad":"__OWNED_IPAD_UUID__"}'
      runtime: __QUALIFIED_RUNTIME__
      device: Mac, portrait iPhone and iPad
      theme: System appearance of the reviewed capture worker
      scenario: Public sample documents
