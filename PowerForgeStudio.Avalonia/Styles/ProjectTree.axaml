<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PowerForgeStudio.Avalonia.Controls">
  <Styles.Resources>
    <ControlTheme x:Key="WorkspaceTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{ReflectionBinding ContextBackground}" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" MinHeight="30"
                    Focusable="True" TemplatedControl.IsTemplateFocusTarget="True" CornerRadius="3">
              <Grid ColumnDefinitions="Auto,18,*">
                <controls:TreeAncestryGuides Level="{TemplateBinding Level}" IsHitTestVisible="False" />
                <Panel Grid.Column="1" Name="PART_ExpandCollapseChevronContainer" Width="18">
                  <ToggleButton Name="PART_ExpandCollapseChevron" Width="9" Height="9" Focusable="False"
                                Theme="{StaticResource FluentTreeViewExpandCollapseChevron}"
                                IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                </Panel>
                <ContentPresenter Grid.Column="2" Name="PART_HeaderPresenter" Margin="5,0,8,0"
                                  Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  VerticalAlignment="Center" HorizontalContentAlignment="Stretch" />
              </Grid>
            </Border>
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" IsVisible="{TemplateBinding IsExpanded}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover"><Setter Property="Background" Value="#EDF3FB" /></Style>
      <Style Selector="^:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="#DCEBFF" /></Style>
      <Style Selector="^:selected /template/ Border#PART_LayoutRoot:pointerover"><Setter Property="Background" Value="#DCEBFF" /></Style>
      <Style Selector="^:focus-visible /template/ Border#PART_LayoutRoot"><Setter Property="BorderBrush" Value="#247CFF" /><Setter Property="BorderThickness" Value="1" /></Style>
    </ControlTheme>
  </Styles.Resources>
</Styles>
