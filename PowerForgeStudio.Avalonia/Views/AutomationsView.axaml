<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PowerForgeStudio.Avalonia.ViewModels"
             xmlns:automation="using:PowerForgeStudio.Domain.Automation"
             x:DataType="vm:AutomationsViewModel" x:Class="PowerForgeStudio.Avalonia.Views.AutomationsView">
  <UserControl.Styles>
    <Style Selector="TextBlock.automationState.attention"><Setter Property="Foreground" Value="#BA2737" /></Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18" Spacing="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <StackPanel Spacing="4">
          <TextBlock Text="Automation inventory" Classes="heading" />
          <TextBlock Text="Provider-owned schedules and their available runtime evidence. Inspection is read-only." Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh inventory" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" VerticalAlignment="Center" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Sources}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="250" ItemHeight="118" ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="automation:WorkspaceAutomationSourceState">
            <Border Classes="card" Padding="14" Margin="0,0,10,0">
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Provider}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding EntryCount}" Foreground="#0865FF" FontWeight="SemiBold" /></Grid>
                <TextBlock Text="{Binding State}" Classes="muted" />
                <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
        <Border Classes="card" Padding="14"><StackPanel><TextBlock Text="{Binding RelevantCount}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="relevant definitions" Classes="muted" /></StackPanel></Border>
        <Border Grid.Column="1" Classes="card" Padding="14"><StackPanel><TextBlock Text="{Binding AttentionCount}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="need attention" Classes="muted" /></StackPanel></Border>
        <Border Grid.Column="2" Classes="card" Padding="14"><StackPanel><TextBlock Text="{Binding DefinitionOnlyCount}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="definition-only" Classes="muted" /></StackPanel></Border>
      </Grid>
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Content="Relevant" Classes="chip" Classes.active="{Binding IsRelevantFilter}" Command="{Binding ShowRelevantCommand}" />
        <Button Content="All observed" Classes="chip" Classes.active="{Binding IsAllFilter}" Command="{Binding ShowAllCommand}" />
        <Button Content="Windows" Classes="chip" Classes.active="{Binding IsWindowsFilter}" Command="{Binding ShowWindowsCommand}" />
        <Button Content="GitHub Actions" Classes="chip" Classes.active="{Binding IsGitHubFilter}" Command="{Binding ShowGitHubCommand}" />
        <Button Content="Needs attention" Classes="chip" Classes.active="{Binding IsAttentionFilter}" Command="{Binding ShowAttentionCommand}" />
      </WrapPanel>
      <Border Classes="card" Padding="0" MinHeight="270">
        <Grid RowDefinitions="42,*">
          <Grid ColumnDefinitions="1.5*,1.1*,1.2*,100,1.1*" ColumnSpacing="12" Margin="16,0">
            <TextBlock Text="Automation" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Provider / project" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Schedule" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="State" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="Last observed run" Classes="muted" VerticalAlignment="Center" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="automation:WorkspaceAutomationEntry">
                <Grid ColumnDefinitions="1.5*,1.1*,1.2*,100,1.1*" ColumnSpacing="12" Margin="10,8">
                  <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" /><TextBlock Text="{Binding Scope}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="{Binding Provider}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ProjectDisplay}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Schedule}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="3" Text="{Binding State}" VerticalAlignment="Center" Classes="automationState" Classes.attention="{Binding NeedsAttention}" />
                  <TextBlock Grid.Column="4" Text="{Binding LastRunDisplay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Text="No automation definitions match this filter." IsVisible="{Binding !HasEntries}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
        </Grid>
      </Border>
      <TextBlock Text="GitHub workflow enablement and recent scheduled runs are verified when access allows; next occurrence is never inferred. Unmatched or unavailable rows remain labeled local definitions. Codex remains unavailable until it exposes a supported inventory API." Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
