<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:publish="using:PowerForgeStudio.Domain.Publish" xmlns:verify="using:PowerForgeStudio.Domain.Verification" xmlns:storage="using:PowerForgeStudio.Orchestrator.Storage" xmlns:queue="using:PowerForgeStudio.Orchestrator.Queue" xmlns:vm="using:PowerForgeStudio.Avalonia.ViewModels" xmlns:domain="using:PowerForgeStudio.Domain.Signing" xmlns:hub="using:PowerForgeStudio.Domain.Hub" xmlns:controls="using:PowerForgeStudio.Avalonia.Controls"
             x:Class="PowerForgeStudio.Avalonia.Views.ReleaseView" x:DataType="vm:ReleaseViewModel">
  <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <controls:NavigationIcon Kind="review" Width="26" Height="26" Ink="#0865FF" VerticalAlignment="Center" />
        <TextBlock Text="Releases" Classes="heading" />
      </StackPanel>
      <TextBlock Text="Prepare, sign, publish and verify artifacts from the captured build." Classes="muted" TextWrapping="Wrap" />
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="7">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Text="Current state" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Stage}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
          <TextBlock Text="Captured working copy" Classes="muted" FontSize="11" />
          <SelectableTextBlock Text="{Binding BuildRoot}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BuildRoot}" FontSize="11" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
        <Border Grid.Column="0" Classes="releaseStep"><TextBlock Text="1  Prepare" Classes="releaseStepText" /></Border>
        <Border Grid.Column="1" Classes="releaseStep"><TextBlock Text="2  Sign" Classes="releaseStepText" /></Border>
        <Border Grid.Column="2" Classes="releaseStep"><TextBlock Text="3  Publish" Classes="releaseStepText" /></Border>
        <Border Grid.Column="3" Classes="releaseStep"><TextBlock Text="4  Verify" Classes="releaseStepText" /></Border>
        <Border Grid.Column="4" Classes="releaseStep"><TextBlock Text="5  History" Classes="releaseStepText" /></Border>
      </Grid>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="5">
      <WrapPanel>
        <Button Content="Prepare built artifacts" Command="{Binding PrepareCommand}" IsEnabled="{Binding CanPrepare}" Classes.primary="{Binding EmphasizePrepare}" Margin="0,0,12,5" />
        <Button Content="Sign artifacts" Command="{Binding SignCommand}" IsEnabled="{Binding CanSign}" Classes.primary="{Binding CanSign}" Margin="0,0,12,5" />
        <Button Content="Cancel signing" Command="{Binding CancelSigningCommand}" IsVisible="{Binding IsSigning}" Margin="0,0,12,5" />
      </WrapPanel>
      <TextBlock Text="{Binding SigningConfigurationStatus}" IsVisible="{Binding ShowSigningConfiguration}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="8">
      <TextBlock Text="{Binding HistoryScopeDisplay}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding HistoryStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <WrapPanel>
        <Button Content="Refresh saved releases" Command="{Binding RefreshHistoryCommand}" IsEnabled="{Binding CanBrowseHistory}" Margin="0,0,8,4" />
        <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" Width="260" PlaceholderText="Recent releases (up to 100)" Margin="0,0,8,4">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="storage:ReleaseHistoryEntry"><TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding WorkingCopy}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Open saved release" Command="{Binding OpenHistoryCommand}" IsEnabled="{Binding CanOpenHistory}" Margin="0,0,0,4" />
      </WrapPanel>
      <StackPanel IsVisible="{Binding HasUnpersistedEvidence}" Spacing="6">
        <TextBlock Text="Receipts have not been saved. Retry saving before leaving this release." TextWrapping="Wrap" Foreground="#B45309" />
        <Button Content="Retry saving receipts" Command="{Binding RetrySaveReceiptsCommand}" IsEnabled="{Binding !IsSavingReceipts}" />
        <CheckBox Content="I accept losing the unsaved receipt copy" IsChecked="{Binding ConfirmDiscardReceipts}" />
        <Button Content="Discard unsaved receipts" Command="{Binding DiscardUnsavedReceiptsCommand}" IsEnabled="{Binding ConfirmDiscardReceipts}" />
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="5" Classes="card" Padding="14">
      <StackPanel Spacing="9">
        <WrapPanel ItemSpacing="10">
          <TextBlock Text="Published on GitHub" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="Refresh releases" Command="{Binding RefreshGitHubReleasesCommand}" IsEnabled="{Binding CanRefreshGitHubReleases}" />
        </WrapPanel>
        <TextBlock Text="{Binding GithubReleaseStatus}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
        <ListBox ItemsSource="{Binding GitHubReleases}" SelectedItem="{Binding SelectedGitHubRelease, Mode=TwoWay}" IsVisible="{Binding HasGitHubReleases}" MaxHeight="170" Background="#F7F9FC">
          <ListBox.ItemTemplate><DataTemplate x:DataType="hub:GitHubReleaseMetric">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3" Margin="8,5">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding StateDisplay}" Foreground="#0865FF" FontSize="11" />
              <TextBlock Grid.Row="1" Text="{Binding TagName}" Classes="muted" FontSize="12" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AssetSummary}" Classes="muted" FontSize="11" />
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel IsVisible="{Binding HasSelectedGitHubRelease}" Spacing="7">
          <WrapPanel ItemSpacing="10">
            <TextBlock Text="{Binding SelectedGitHubRelease.PublishedDisplay}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
            <Button Content="Open release on GitHub" Command="{Binding OpenGitHubReleaseCommand}" IsEnabled="{Binding CanOpenGitHubRelease}" />
          </WrapPanel>
          <TextBlock Text="Asset downloads" FontWeight="SemiBold" FontSize="12" />
          <ItemsControl ItemsSource="{Binding SelectedGitHubRelease.Assets}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="hub:GitHubReleaseAssetMetric">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="8,3">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding DownloadsDisplay}" FontWeight="SemiBold" />
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>
    <Grid Grid.Row="4" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
      <TextBlock IsVisible="{Binding HasArtifacts}" Text="Release artifacts" FontSize="16" FontWeight="SemiBold" />
      <ListBox Grid.Row="1" IsVisible="{Binding HasArtifacts}" MaxHeight="200" ItemsSource="{Binding Artifacts}" Background="#F7F9FC">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="domain:ReleaseSigningArtifact">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3" Margin="8,5">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                <TextBlock Text="{Binding AdapterKind}" Foreground="#0865FF" FontSize="11" />
                <TextBlock Text="{Binding ArtifactKind}" Classes="muted" FontSize="11" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ArtifactPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ArtifactPath}" FontSize="11" Classes="muted" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="2" IsVisible="{Binding HasExecutionProgress}" Text="Release activity · newest first" FontSize="16" FontWeight="SemiBold" />
      <ProgressBar Grid.Row="3" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressCompleted}" IsVisible="{Binding HasDeterminateProgress}" Height="4" />
      <ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding ShowIndeterminateProgress}" Height="4" />
      <TextBlock Grid.Row="4" Text="{Binding ProgressStatus}" IsVisible="{Binding HasExecutionProgress}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <ListBox Grid.Row="5" IsVisible="{Binding HasExecutionProgress}" MaxHeight="180" ItemsSource="{Binding RecentExecutionProgress}" Background="#F7F9FC">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="queue:ReleaseArtifactProgress">
            <StackPanel Spacing="4" Margin="8">
              <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted" />
              <TextBlock Text="{Binding ItemPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ItemPath}" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="6" IsVisible="{Binding HasReceipts}" Text="Signing receipts" FontSize="16" FontWeight="SemiBold" />
      <ListBox Grid.Row="7" IsVisible="{Binding HasReceipts}" MaxHeight="300" ItemsSource="{Binding Receipts}" Background="#F7F9FC">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="domain:ReleaseSigningReceipt">
            <StackPanel Spacing="5" Margin="8">
              <TextBlock Text="{Binding ArtifactName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Status}" Foreground="#0865FF" />
              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ArtifactPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ArtifactPath}" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <StackPanel Grid.Row="3" Spacing="8" IsVisible="{Binding ShowPublicationDetails}">
      <TextBlock x:Name="PublicationHeading" Text="Publication destinations" FontSize="16" FontWeight="SemiBold" />
      <WrapPanel>
        <Button Content="Inspect publication targets" Command="{Binding InspectPublicationCommand}" IsVisible="{Binding CanInspectPublication}" Margin="0,0,8,4" />
        <Button Content="Cancel publication" Command="{Binding CancelPublicationCommand}" IsVisible="{Binding IsPublishing}" Margin="0,0,8,4" />
        <Button Content="Verify published targets" Command="{Binding VerifyCommand}" IsVisible="{Binding CanVerify}" Margin="0,0,8,4" />
        <Button Content="Cancel verification" Command="{Binding CancelVerificationCommand}" IsVisible="{Binding IsVerifying}" Margin="0,0,8,4" />
      </WrapPanel>
      <TextBlock Text="{Binding PublicationSummary}" TextWrapping="Wrap" />
      <ListBox ItemsSource="{Binding PublicationTargets}" IsVisible="{Binding HasPublicationTargets}" MaxHeight="260">
        <ListBox.ItemTemplate><DataTemplate x:DataType="publish:ReleasePublishTarget">
          <StackPanel Spacing="5" Margin="8">
            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding TargetKind}" Foreground="#0865FF" />
            <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" FontSize="12" />
          </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <CheckBox Content="I reviewed these destinations and approve external publication" IsChecked="{Binding ConfirmPublication}" IsVisible="{Binding CanReviewPublication}" />
      <Button Content="Publish signed artifacts" Command="{Binding PublishCommand}" IsEnabled="{Binding CanPublish}" IsVisible="{Binding CanReviewPublication}" Background="#0865FF" Foreground="White" />
      <TextBlock IsVisible="{Binding HasPublicationReceipts}" Text="Publication receipts" FontSize="16" FontWeight="SemiBold" />
      <ListBox IsVisible="{Binding HasPublicationReceipts}" ItemsSource="{Binding PublicationReceipts}" SelectedItem="{Binding SelectedPublicationReceipt, Mode=TwoWay}" MaxHeight="260" Background="#F7F9FC">
        <ListBox.ItemTemplate><DataTemplate x:DataType="publish:ReleasePublishReceipt">
          <StackPanel Spacing="5" Margin="8">
            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Status}" Foreground="#0865FF" />
            <TextBlock Text="{Binding PackageIdentityDisplay}" IsVisible="{Binding HasPackageIdentity}" FontSize="12" Foreground="#4C5F79" />
            <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Button Content="Compare selected package with public snapshot" Command="{Binding InspectPublicPackageCommand}" IsEnabled="{Binding CanInspectPublicPackage}" IsVisible="{Binding HasPublicationReceipts}" HorizontalAlignment="Left" />
      <TextBlock x:Name="VerificationHeading" IsVisible="{Binding HasVerificationReceipts}" Text="Verification receipts" FontSize="16" FontWeight="SemiBold" />
      <ListBox IsVisible="{Binding HasVerificationReceipts}" ItemsSource="{Binding VerificationReceipts}" MaxHeight="260" Background="#F7F9FC">
        <ListBox.ItemTemplate><DataTemplate x:DataType="verify:ReleaseVerificationReceipt">
          <StackPanel Spacing="5" Margin="8">
            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Status}" Foreground="#0865FF" />
            <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
