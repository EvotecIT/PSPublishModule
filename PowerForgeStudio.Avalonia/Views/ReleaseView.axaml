<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:publish="using:PowerForgeStudio.Domain.Publish" xmlns:verify="using:PowerForgeStudio.Domain.Verification" xmlns:storage="using:PowerForgeStudio.Orchestrator.Storage" xmlns:vm="using:PowerForgeStudio.Avalonia.ViewModels" xmlns:domain="using:PowerForgeStudio.Domain.Signing"
             x:Class="PowerForgeStudio.Avalonia.Views.ReleaseView" x:DataType="vm:ReleaseViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
    <StackPanel Spacing="8">
      <TextBlock Text="Release workspace" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Captured build working copy" Classes="muted" FontSize="12" />
      <SelectableTextBlock Text="{Binding BuildRoot}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
    <WrapPanel Grid.Row="1">
      <Button Content="Prepare built artifacts" Command="{Binding PrepareCommand}" IsEnabled="{Binding CanPrepare}" Background="#0865FF" Foreground="White" Margin="0,0,16,5" />
      <Button Content="Sign artifacts" Command="{Binding SignCommand}" IsEnabled="{Binding CanSign}" Margin="0,0,12,5" />
      <Button Content="Cancel signing" Command="{Binding CancelSigningCommand}" IsVisible="{Binding IsSigning}" Margin="0,0,12,5" />
      <TextBlock Text="{Binding Stage}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,5" />
    </WrapPanel>
    <StackPanel Grid.Row="2" Spacing="8">
      <WrapPanel>
        <Button Content="Refresh saved releases" Command="{Binding RefreshHistoryCommand}" IsEnabled="{Binding CanBrowseHistory}" Margin="0,0,8,4" />
        <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" Width="260" PlaceholderText="Recent releases (up to 100)" Margin="0,0,8,4">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="storage:ReleaseHistoryEntry"><TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding WorkingCopy}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Open saved release" Command="{Binding OpenHistoryCommand}" IsEnabled="{Binding CanBrowseHistory}" Margin="0,0,0,4" />
      </WrapPanel>
      <StackPanel IsVisible="{Binding HasUnpersistedEvidence}" Spacing="6">
        <TextBlock Text="Receipts have not been saved. Retry saving before leaving this release." TextWrapping="Wrap" Foreground="#B45309" />
        <Button Content="Retry saving receipts" Command="{Binding RetrySaveReceiptsCommand}" IsEnabled="{Binding !IsSavingReceipts}" />
        <CheckBox Content="I accept losing the unsaved receipt copy" IsChecked="{Binding ConfirmDiscardReceipts}" />
        <Button Content="Discard unsaved receipts" Command="{Binding DiscardUnsavedReceiptsCommand}" IsEnabled="{Binding ConfirmDiscardReceipts}" />
      </StackPanel>
    </StackPanel>
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
      <TextBlock IsVisible="{Binding HasArtifacts}" Text="Release artifacts" FontSize="16" FontWeight="SemiBold" />
      <ListBox Grid.Row="1" IsVisible="{Binding HasArtifacts}" MaxHeight="200" ItemsSource="{Binding Artifacts}" Background="#F7F9FC">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="domain:ReleaseSigningArtifact">
            <StackPanel Spacing="6" Margin="8">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ArtifactPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ArtifactPath}" FontSize="12" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding AdapterKind}" Foreground="#0865FF" FontSize="12" />
                <TextBlock Text="{Binding ArtifactKind}" Classes="muted" FontSize="12" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding IsSigning}" Height="4" />
      <TextBlock Grid.Row="3" Text="Signing receipts" FontSize="16" FontWeight="SemiBold" />
      <ListBox Grid.Row="4" MaxHeight="300" ItemsSource="{Binding Receipts}" Background="#F7F9FC">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="domain:ReleaseSigningReceipt">
            <StackPanel Spacing="5" Margin="8">
              <TextBlock Text="{Binding ArtifactName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Status}" Foreground="#0865FF" />
              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ArtifactPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ArtifactPath}" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <StackPanel Grid.Row="4" Spacing="8">
      <WrapPanel>
        <Button Content="Inspect publication targets" Command="{Binding InspectPublicationCommand}" IsEnabled="{Binding CanInspectPublication}" Margin="0,0,8,4" />
        <Button Content="Cancel publication" Command="{Binding CancelPublicationCommand}" IsVisible="{Binding IsPublishing}" Margin="0,0,8,4" />
        <Button Content="Verify published targets" Command="{Binding VerifyCommand}" IsEnabled="{Binding CanVerify}" Margin="0,0,8,4" />
        <Button Content="Cancel verification" Command="{Binding CancelVerificationCommand}" IsVisible="{Binding IsVerifying}" Margin="0,0,8,4" />
      </WrapPanel>
      <TextBlock Text="{Binding PublicationSummary}" TextWrapping="Wrap" />
      <ListBox ItemsSource="{Binding PublicationTargets}" MaxHeight="260">
        <ListBox.ItemTemplate><DataTemplate x:DataType="publish:ReleasePublishTarget">
          <StackPanel Spacing="5" Margin="8">
            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding TargetKind}" Foreground="#0865FF" />
            <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" FontSize="12" />
          </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <CheckBox Content="I reviewed these destinations and approve external publication" IsChecked="{Binding ConfirmPublication}" IsEnabled="{Binding CanInspectPublication}" />
      <Button Content="Publish signed artifacts" Command="{Binding PublishCommand}" IsEnabled="{Binding CanPublish}" Background="#0865FF" Foreground="White" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPublishing}" Height="4" />
      <TextBlock IsVisible="{Binding HasPublicationReceipts}" Text="Publication receipts" FontSize="16" FontWeight="SemiBold" />
      <ListBox IsVisible="{Binding HasPublicationReceipts}" ItemsSource="{Binding PublicationReceipts}" MaxHeight="260" Background="#F7F9FC">
        <ListBox.ItemTemplate><DataTemplate x:DataType="publish:ReleasePublishReceipt">
          <StackPanel Spacing="5" Margin="8">
            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Status}" Foreground="#0865FF" />
            <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsVerifying}" Height="4" />
      <TextBlock IsVisible="{Binding HasVerificationReceipts}" Text="Verification receipts" FontSize="16" FontWeight="SemiBold" />
      <ListBox IsVisible="{Binding HasVerificationReceipts}" ItemsSource="{Binding VerificationReceipts}" MaxHeight="260" Background="#F7F9FC">
        <ListBox.ItemTemplate><DataTemplate x:DataType="verify:ReleaseVerificationReceipt">
          <StackPanel Spacing="5" Margin="8">
            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Status}" Foreground="#0865FF" />
            <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
