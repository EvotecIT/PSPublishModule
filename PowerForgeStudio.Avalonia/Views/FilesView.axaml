<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PowerForgeStudio.Avalonia.ViewModels"
             xmlns:controls="using:PowerForgeStudio.Avalonia.Controls"
             x:Class="PowerForgeStudio.Avalonia.Views.FilesView" x:DataType="vm:WorkspaceViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="22,18">
    <TextBlock Text="Files" Classes="heading" />
    <TextBlock Grid.Row="1" Text="{Binding CurrentDirectoryDisplay}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentDirectory}" Margin="0,9,0,13" />
    <Border Grid.Row="2" Background="#F5F8FD" BorderBrush="#DDE7F3" BorderThickness="1" CornerRadius="7"
            Padding="7,5" Margin="0,0,0,13" IsEnabled="{Binding CanManageFiles}" IsVisible="{Binding IsPreviewVisible}">
      <WrapPanel ItemSpacing="3" LineSpacing="3">
        <Button Classes="fileAction" Command="{Binding NavigateUpCommand}" IsEnabled="{Binding HasWorkingCopy}" ToolTip.Tip="Parent folder" AutomationProperties.Name="Parent folder">
          <controls:NavigationIcon Kind="up" Ink="#35506C" Width="17" Height="17" />
        </Button>
        <Border Background="#DDE7F3" Width="1" Margin="4,5" />
        <Button Classes="fileAction primary" Tag="CreateFile" Click="ManageFile" IsEnabled="{Binding HasWorkingCopy}" AutomationProperties.Name="New file">
          <StackPanel Orientation="Horizontal" Spacing="6"><controls:NavigationIcon Kind="file-new" Width="16" Height="16" /><TextBlock Text="New file" /></StackPanel>
        </Button>
        <Button Classes="fileAction" Tag="CreateDirectory" Click="ManageFile" IsEnabled="{Binding HasWorkingCopy}" AutomationProperties.Name="New folder">
          <StackPanel Orientation="Horizontal" Spacing="6"><controls:NavigationIcon Kind="folder-new" Ink="#35506C" Width="16" Height="16" /><TextBlock Text="New folder" /></StackPanel>
        </Button>
        <Border Background="#DDE7F3" Width="1" Margin="4,5" />
        <Button Classes="fileAction" Tag="Copy" Click="ManageFile" IsEnabled="{Binding HasSelectedFile}" AutomationProperties.Name="Copy">
          <StackPanel Orientation="Horizontal" Spacing="6"><controls:NavigationIcon Kind="copy" Ink="#35506C" Width="16" Height="16" /><TextBlock Text="Copy" /></StackPanel>
        </Button>
        <Button Classes="fileAction" Tag="Move" Click="ManageFile" IsEnabled="{Binding HasSelectedFile}" AutomationProperties.Name="Move">
          <StackPanel Orientation="Horizontal" Spacing="6"><controls:NavigationIcon Kind="move" Ink="#35506C" Width="16" Height="16" /><TextBlock Text="Move" /></StackPanel>
        </Button>
        <Button Classes="fileAction" Tag="Rename" Click="ManageFile" IsEnabled="{Binding HasSelectedFile}" AutomationProperties.Name="Rename">
          <StackPanel Orientation="Horizontal" Spacing="6"><controls:NavigationIcon Kind="rename" Ink="#35506C" Width="16" Height="16" /><TextBlock Text="Rename" /></StackPanel>
        </Button>
        <Button Classes="fileAction" ToolTip.Tip="More file actions" AutomationProperties.Name="More file actions">
          <StackPanel Orientation="Horizontal" Spacing="5"><controls:NavigationIcon Kind="more" Ink="#35506C" Width="16" Height="16" /><TextBlock Text="More" /></StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Move to recovery" Click="DeleteFile" IsEnabled="{Binding HasSelectedFile}" />
              <MenuItem Header="Recovery" Click="ShowRecovery" IsEnabled="{Binding HasWorkingCopy}" />
              <Separator />
              <MenuItem Header="Refresh folder" Command="{Binding RefreshFolderCommand}" IsEnabled="{Binding HasWorkingCopy}" />
              <MenuItem Header="Copy path" Click="CopyPath" IsEnabled="{Binding HasWorkingCopy}" />
              <MenuItem Header="Open externally" Click="OpenExternally" IsEnabled="{Binding HasSelectedFile}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </WrapPanel>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="0.85*,14,1.15*">
      <Border Classes="card" IsVisible="{Binding IsPreviewVisible}">
        <Grid RowDefinitions="42,*">
          <Border Background="#F4F8FD" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9" Margin="15,12">
              <TextBlock Text="Name" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="Modified" FontWeight="SemiBold"
                         IsVisible="{ReflectionBinding !DataContext.CompactViewport, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" MinWidth="45" TextAlignment="Right" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1" x:Name="FileList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                   DoubleTapped="OpenFile" KeyDown="FileKeyDown" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FileItemViewModel">
                <Grid ColumnDefinitions="20,*,Auto,Auto" ColumnSpacing="9" ToolTip.Tip="{Binding FullPath}">
                  <controls:ProjectIcon Kind="{Binding IconKind}" Width="20" Height="20" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding ModifiedDateDisplay}" Classes="muted" FontSize="11" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding ModifiedDisplay}"
                             IsVisible="{ReflectionBinding !DataContext.CompactViewport, RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" Classes="muted" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="45" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="{Binding EditorColumn}" Grid.ColumnSpan="{Binding EditorColumnSpan}" Classes="card">
        <Grid RowDefinitions="42,Auto,Auto,*">
          <Border Background="#F4F8FD" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="15,5">
              <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Content="Edit" Click="BeginEdit" IsVisible="{Binding IsPreviewVisible}" IsEnabled="{Binding CanEditDocument}" Padding="10,5" />
            </Grid>
          </Border>
          <WrapPanel Grid.Row="1" Margin="12,0,12,8">
            <Button Content="Save" Command="{Binding SaveActiveDocumentCommand}" IsVisible="{Binding IsEditorVisible}" IsEnabled="{Binding CanSaveDocument}" Margin="0,0,6,4" />
            <Button Content="Reload" Command="{Binding ReloadDocumentCommand}" IsVisible="{Binding IsEditorVisible}" IsEnabled="{Binding CanEditDocument}" Margin="0,0,6,4" />
            <Button Content="Browse files" Command="{Binding ShowWorkspaceCommand}" IsVisible="{Binding IsEditorVisible}" Margin="0,0,6,4" />
            <TextBlock Text="{Binding ActiveDocument.EncodingLabel}" IsVisible="{Binding IsEditorVisible}" Classes="muted" Margin="4,8" />
          </WrapPanel>
          <ScrollViewer Grid.Row="2" MaxHeight="70" IsVisible="{Binding ActiveDocument.HasError}" Margin="15,0,15,10">
            <TextBlock Text="{Binding ActiveDocument.Error}" Foreground="#B45309" TextWrapping="Wrap" />
          </ScrollViewer>
          <TextBox Grid.Row="3" Text="{Binding Preview}" IsVisible="{Binding IsPreviewVisible}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Cascadia Code, Consolas, monospace" FontSize="13" BorderThickness="0" Padding="15"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          <TextBox Grid.Row="3" x:Name="EditorBox" Text="{Binding ActiveDocument.Text, Mode=TwoWay}" IsVisible="{Binding IsEditorVisible}" IsReadOnly="{Binding IsEditorReadOnly}"
                   AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Cascadia Code, Consolas, monospace"
                   FontSize="13" BorderThickness="0" Padding="15" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TextBox.KeyBindings><KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveDocumentCommand}" /></TextBox.KeyBindings>
          </TextBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
