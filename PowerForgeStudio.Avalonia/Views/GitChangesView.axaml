<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PowerForgeStudio.Avalonia.ViewModels"
             x:Class="PowerForgeStudio.Avalonia.Views.GitChangesView" x:DataType="vm:GitChangesViewModel">
  <Grid Margin="18">
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" MinHeight="620" Height="{Binding #PageScroll.Bounds.Height}">
    <StackPanel Spacing="6">
      <TextBlock Text="Changes" FontSize="22" FontWeight="SemiBold" />
      <SelectableTextBlock Text="{Binding Root}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Root}" FontSize="12" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
    <Expander Grid.Row="1" Header="Branch actions" IsExpanded="False">
    <Border Background="#F7F9FC" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6" Padding="10">
      <StackPanel Spacing="8">
        <WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
            <ComboBox Width="220" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                      PlaceholderText="Select local branch" Margin="0,0,8,0" />
            <Button Content="Switch" Command="{Binding SwitchBranchCommand}" IsEnabled="{Binding CanSwitchBranch}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="260" Text="{Binding NewBranchName}" PlaceholderText="feature/my-branch" Margin="0,0,8,0" />
            <Button Content="Create &amp; switch" Command="{Binding CreateBranchCommand}" IsEnabled="{Binding CanCreateBranch}" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>
    </Expander>
    <WrapPanel Grid.Row="2">
      <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
      <Button Content="Stage selected" Command="{Binding StageCommand}" IsEnabled="{Binding CanStage}" Margin="0,0,8,0" />
      <Button Content="Unstage selected" Command="{Binding UnstageCommand}" IsEnabled="{Binding CanUnstage}" />
    </WrapPanel>
    <Grid Grid.Row="3" ColumnDefinitions="2*,5,3*">
      <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding Selected, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:GitChangeRow">
            <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto" Margin="2,5">
              <TextBlock Text="{Binding Kind}" Foreground="#0865FF" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding State}" Classes="muted" FontSize="12" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <Border Grid.Column="2" Background="#F7F9FC" BorderBrush="#DCE3ED" BorderThickness="1" Padding="10">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock Text="{Binding Diff}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="13" LineHeight="17" />
        </ScrollViewer>
      </Border>
    </Grid>
    <StackPanel Grid.Row="4" Spacing="8">
      <TextBlock Text="Commit all currently staged changes" FontWeight="SemiBold" />
      <TextBox Text="{Binding CommitMessage}" PlaceholderText="Commit message" AcceptsReturn="True" MinHeight="58" MaxHeight="100" />
      <Button Content="Commit staged changes" Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommit}" Background="#0865FF" Foreground="White" HorizontalAlignment="Left" />
    </StackPanel>
  </Grid>
  </ScrollViewer>
  </Grid>
</UserControl>
