<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PowerForgeStudio.Avalonia.ViewModels"
             xmlns:domain="using:PowerForgeStudio.Domain.Portfolio"
             xmlns:queue="using:PowerForgeStudio.Orchestrator.Queue"
             xmlns:controls="using:PowerForgeStudio.Avalonia.Controls"
             x:Class="PowerForgeStudio.Avalonia.Views.BuildView" x:DataType="vm:BuildViewModel">
  <ScrollViewer x:Name="PageScroll">
    <StackPanel Margin="22,14" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <controls:NavigationIcon Kind="output" Width="26" Height="26" Ink="#0865FF" VerticalAlignment="Center" />
        <TextBlock Text="Build &amp; Run" Classes="heading" />
      </StackPanel>
      <TextBlock Text="Inspect the working copy, review local actions, then build." Classes="muted" TextWrapping="Wrap" />
      <Border Classes="card" Padding="10">
        <StackPanel Spacing="5">
          <TextBlock Text="Working copy" Classes="muted" FontSize="11" />
          <SelectableTextBlock Text="{Binding WorkingCopyRoot}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorkingCopyRoot}" FontSize="12" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <TextBlock Text="Save or discard this working copy's drafts before inspecting or building. Build commands use files on disk." IsVisible="{Binding HasUnsavedChanges}" Foreground="#B45309" TextWrapping="Wrap" />
      <Border Background="#EEF4FF" CornerRadius="6" Padding="11">
        <StackPanel Spacing="4">
          <TextBlock Text="Review before execution" FontWeight="SemiBold" Foreground="#0865FF" />
          <TextBlock Text="Studio does not request a build or publication while planning. Script-backed contracts can run trusted PowerShell to export a plan and may have side effects. Reviewed actions omit arguments; output may contain secrets." TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Inspect &amp; plan" Command="{Binding PlanCommand}" IsEnabled="{Binding CanPlan}" Classes.primary="{Binding EmphasizePlan}" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        <Button Content="Build current configuration" Command="{Binding BuildCommand}" IsEnabled="{Binding CanBuild}" Classes.primary="{Binding CanBuild}" />
      </StackPanel>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
      <TextBlock Text="Detected contracts" FontWeight="SemiBold" />
      <SelectableTextBlock Text="{Binding ContractDisplay}" ToolTip.Tip="{Binding Contracts}" TextWrapping="Wrap" FontSize="12" />
      <ItemsControl ItemsSource="{Binding Results}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="domain:RepositoryPlanResult">
            <Border Classes="card" Padding="0" Margin="0,0,0,10" ClipToBounds="True">
              <StackPanel>
                <Border Background="#F7F9FC" Padding="14,11" BorderBrush="#DDE5EF" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding AdapterKind}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#E7F6EC" CornerRadius="12" Padding="10,3" VerticalAlignment="Top" IsVisible="{Binding IsSucceeded}">
                    <TextBlock Text="{Binding Status}" Foreground="#14833B" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <Border Grid.Column="1" Background="#FDEBEC" CornerRadius="12" Padding="10,3" VerticalAlignment="Top" IsVisible="{Binding IsFailed}">
                    <TextBlock Text="{Binding Status}" Foreground="#BA2737" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <Border Grid.Column="1" Background="#EEF2F7" CornerRadius="12" Padding="10,3" VerticalAlignment="Top" IsVisible="{Binding IsNeutral}">
                    <TextBlock Text="{Binding Status}" Foreground="#53657A" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                </Grid>
                </Border>
                <StackPanel Margin="14,12" Spacing="9">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="Reviewed actions" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Build executes local actions; publishing and installation continue in Releases." Classes="muted" TextWrapping="Wrap" HorizontalAlignment="Right" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="domain:RepositoryPlanAction">
                        <Border Background="#F8FAFD" BorderBrush="#E4EAF2" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="32,92,*" RowDefinitions="Auto,Auto">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#E4EFFF" HorizontalAlignment="Left" VerticalAlignment="Top">
                              <TextBlock Text="{Binding Sequence}" Foreground="#0865FF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Background="#EEF2F7" CornerRadius="11" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                              <TextBlock Text="{Binding Lane}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Action}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" Spacing="2">
                              <SelectableTextBlock Text="{Binding Target}" TextWrapping="Wrap" FontSize="12" />
                              <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Plan source" Classes="muted" FontSize="11" />
                  <SelectableTextBlock Text="{Binding PlanPath}" TextWrapping="Wrap" FontSize="11" />
                  <SelectableTextBlock Text="{Binding OutputTail}" TextWrapping="Wrap" FontSize="12" />
                  <SelectableTextBlock Text="{Binding ErrorTail}" TextWrapping="Wrap" Foreground="#AE2424" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Build runs the current configuration with publishing disabled through PowerForge. Project scripts and build hooks execute code; project builds may perform configured local signing. Changing projects leaves an active build running; its working copy is shown below." Classes="muted" TextWrapping="Wrap" />
      <Border IsVisible="{Binding HasBuild}" BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock x:Name="BuildResultHeading" Text="Build result" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding BuildStatus}" TextWrapping="Wrap" />
          <TextBlock Text="Captured working copy" Classes="muted" FontSize="11" />
          <SelectableTextBlock Text="{Binding BuildRoot}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BuildRoot}" FontSize="12" />
          <ProgressBar IsVisible="{Binding IsBuilding}" IsIndeterminate="True" Height="3" />
          <Button Content="Cancel build" Command="{Binding CancelBuildCommand}" IsVisible="{Binding IsBuilding}" HorizontalAlignment="Left" />
          <ItemsControl ItemsSource="{Binding BuildResult.AdapterResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="queue:ReleaseBuildAdapterResult">
                <StackPanel Spacing="6" Margin="0,8">
                  <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <SelectableTextBlock Text="{Binding ErrorTail}" Foreground="#AE2424" TextWrapping="Wrap" FontSize="12" />
                  <SelectableTextBlock Text="{Binding OutputTail}" TextWrapping="Wrap" FontSize="12" />
                  <ItemsControl ItemsSource="{Binding ArtifactFiles}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid ColumnDefinitions="65,*" ColumnSpacing="8" Margin="0,2">
                        <TextBlock Text="File" Classes="muted" FontSize="11" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" FontSize="12" />
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding ArtifactDirectories}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid ColumnDefinitions="65,*" ColumnSpacing="8" Margin="0,2">
                        <TextBlock Text="Directory" Classes="muted" FontSize="11" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" FontSize="12" />
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
