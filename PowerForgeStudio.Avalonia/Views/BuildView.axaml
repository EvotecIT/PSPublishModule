<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PowerForgeStudio.Avalonia.ViewModels"
             xmlns:domain="using:PowerForgeStudio.Domain.Portfolio"
             x:Class="PowerForgeStudio.Avalonia.Views.BuildView" x:DataType="vm:BuildViewModel">
  <ScrollViewer>
    <StackPanel Margin="22,18" Spacing="14">
      <TextBlock Text="Build configuration &amp; plans" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Working copy" Classes="muted" />
      <SelectableTextBlock Text="{Binding WorkingCopyRoot}" TextWrapping="Wrap" />
      <Border Background="#EEF4FF" CornerRadius="6" Padding="14">
        <TextBlock Text="Project and release contracts generate plans. Module JSON is checked for a valid configuration. PowerShell contracts may run project code to export configuration; inspect only projects you trust." TextWrapping="Wrap" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Inspect &amp; plan" Command="{Binding PlanCommand}" IsEnabled="{Binding CanPlan}" Background="#0865FF" Foreground="White" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
      </StackPanel>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      <TextBlock Text="Detected contracts" FontWeight="SemiBold" />
      <SelectableTextBlock Text="{Binding Contracts}" TextWrapping="Wrap" FontSize="12" />
      <ItemsControl ItemsSource="{Binding Results}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="domain:RepositoryPlanResult">
            <Border BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding AdapterKind}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Status}" />
                </Grid>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding PlanPath}" TextWrapping="Wrap" FontSize="12" />
                <SelectableTextBlock Text="{Binding OutputTail}" TextWrapping="Wrap" FontSize="12" />
                <SelectableTextBlock Text="{Binding ErrorTail}" TextWrapping="Wrap" Foreground="#AE2424" FontSize="12" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Build execution, signing, publishing and artifact receipts are being connected. A successful plan does not mean a package has been built or published." Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
