<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PowerForgeStudio.Avalonia.ViewModels"
             xmlns:activity="using:PowerForgeStudio.Domain.Activity"
             x:DataType="vm:ActivityViewModel" x:Class="PowerForgeStudio.Avalonia.Views.ActivityView">
  <UserControl.Styles>
    <Style Selector="TextBlock.activitySeverity.critical"><Setter Property="Foreground" Value="#BA2737" /></Style>
    <Style Selector="TextBlock.activitySeverity.warning"><Setter Property="Foreground" Value="#B45309" /></Style>
    <Style Selector="TextBlock.activitySeverity.review"><Setter Property="Foreground" Value="#0865FF" /></Style>
    <Style Selector="TextBlock.sourceState.available"><Setter Property="Foreground" Value="#14833B" /></Style>
    <Style Selector="TextBlock.sourceState.partial"><Setter Property="Foreground" Value="#B45309" /></Style>
    <Style Selector="TextBlock.sourceState.unavailable"><Setter Property="Foreground" Value="#BA2737" /></Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18" Spacing="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <StackPanel Spacing="4">
          <TextBlock Text="Activity" Classes="heading" />
          <TextBlock Text="One read-only inbox for project readiness, releases, GitHub reviews, issues, CI and schedules." Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh evidence" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" VerticalAlignment="Center" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Sources}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="218" ItemHeight="116" ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="activity:WorkspaceActivitySourceState">
            <Border Classes="card" Padding="13" Margin="0,0,10,0">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Provider}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding EntryCount}" Foreground="#0865FF" FontWeight="SemiBold" /></Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding State}" Classes="sourceState" Classes.available="{Binding IsAvailable}" Classes.partial="{Binding IsPartial}" Classes.unavailable="{Binding IsUnavailable}" />
                  <TextBlock Grid.Column="1" Text="{Binding ObservedDisplay}" Classes="muted" FontSize="10" />
                </Grid>
                <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" MaxHeight="43" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
        <Border Classes="card" Padding="14"><StackPanel><TextBlock Text="{Binding ActionableCount}" FontSize="22" FontWeight="SemiBold" Foreground="#0865FF" /><TextBlock Text="actionable signals" Classes="muted" /></StackPanel></Border>
        <Border Grid.Column="1" Classes="card" Padding="14"><StackPanel><TextBlock Text="{Binding CriticalCount}" FontSize="22" FontWeight="SemiBold" Foreground="#BA2737" /><TextBlock Text="critical failures" Classes="muted" /></StackPanel></Border>
        <Border Grid.Column="2" Classes="card" Padding="14"><StackPanel><TextBlock Text="{Binding ReviewCount}" FontSize="22" FontWeight="SemiBold" Foreground="#14833B" /><TextBlock Text="issues / reviews" Classes="muted" /></StackPanel></Border>
      </Grid>

      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Content="Needs attention" Classes="chip" Classes.active="{Binding IsAttentionFilter}" Command="{Binding ShowAttentionCommand}" />
        <Button Content="All activity" Classes="chip" Classes.active="{Binding IsAllFilter}" Command="{Binding ShowAllCommand}" />
        <Button Content="GitHub" Classes="chip" Classes.active="{Binding IsGitHubFilter}" Command="{Binding ShowGitHubCommand}" />
        <Button Content="Releases" Classes="chip" Classes.active="{Binding IsReleasesFilter}" Command="{Binding ShowReleasesCommand}" />
        <Button Content="Schedules" Classes="chip" Classes.active="{Binding IsSchedulesFilter}" Command="{Binding ShowSchedulesCommand}" />
        <Button Content="Muted · session" Classes="chip" Classes.active="{Binding IsMutedFilter}" Command="{Binding ShowMutedCommand}" />
      </WrapPanel>

      <Border Background="#FFF7E6" BorderBrush="#F4C96B" BorderThickness="1" CornerRadius="6" Padding="10" IsVisible="{Binding IsTruncated}">
        <TextBlock Text="{Binding OmittedCount, StringFormat='The bounded Activity view omitted {0} lower-priority signal(s). Open the owning project detail pages for complete provider evidence.'}" TextWrapping="Wrap" />
      </Border>

      <Border Classes="card" Padding="0" MinHeight="300">
        <Grid RowDefinitions="42,*">
          <Grid ColumnDefinitions="1.15*,100,1.7*,120" ColumnSpacing="12" Margin="16,0">
            <TextBlock Text="Project" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Kind" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Attention item" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="Observed" Classes="muted" VerticalAlignment="Center" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="activity:WorkspaceActivityEntry">
                <Grid ColumnDefinitions="1.15*,100,1.7*,120" ColumnSpacing="12" Margin="10,8">
                  <StackPanel><TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Provider}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding State}" Classes="activitySeverity" Classes.critical="{Binding IsCritical}" Classes.warning="{Binding IsWarning}" Classes.review="{Binding IsReview}" FontSize="11" /></StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding ObservedDisplay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" Text="No activity matches this filter. Provider gaps remain visible above." IsVisible="{Binding !HasEntries}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" Margin="20" />
        </Grid>
      </Border>

      <Border Background="#EFF5FF" BorderBrush="#A9C8FF" BorderThickness="1" CornerRadius="6" Padding="11">
        <TextBlock Text="Activity is evidence, not a second issue tracker. Open source goes to the owning folder or GitHub page; hiding an item lasts only for this Studio session." TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
