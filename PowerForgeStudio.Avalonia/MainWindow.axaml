<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PowerForgeStudio.Avalonia.ViewModels"
        xmlns:views="using:PowerForgeStudio.Avalonia.Views"
        xmlns:controls="using:PowerForgeStudio.Avalonia.Controls"
        x:Class="PowerForgeStudio.Avalonia.MainWindow" x:DataType="vm:WorkspaceViewModel"
        Width="1600" Height="1000" MinWidth="1050" MinHeight="700" Title="PowerForge Studio">
  <Grid RowDefinitions="48,*,30">
    <Border Grid.Row="0">
      <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#193958" /><GradientStop Color="#061A34" Offset="1" /></LinearGradientBrush></Border.Background>
      <Grid ColumnDefinitions="360,*,280" Margin="22,0">
        <TextBlock Text="Project workspace" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Grid Grid.Column="1" MaxWidth="550" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <TextBox Text="{Binding Filter}" PlaceholderText="Find a project…" Padding="32,6,10,6" Background="#EEF3FA" BorderBrush="#B8CAE0" />
          <controls:NavigationIcon Kind="search" Width="17" Height="17" Ink="#617189" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right"><controls:NavigationIcon Kind="monitor" Width="21" Height="21" Ink="#D6E4F7" /><TextBlock Text="Local workspace" Foreground="#D6E4F7" /></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" x:Name="WorkspaceLayout" ColumnDefinitions="70,326,5,*,280">
      <Border Background="#0B2745">
        <StackPanel Spacing="4" Margin="0,10">
          <Button Classes="rail" Classes.selected="{Binding IsProjectRoute}" Command="{Binding ShowOverviewCommand}"><StackPanel Spacing="7"><controls:NavigationIcon Kind="projects" Width="24" Height="24" HorizontalAlignment="Center" /><TextBlock Text="Projects" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsActivityRailSelected}" Command="{Binding ShowActivityCommand}"><StackPanel Spacing="7"><controls:NavigationIcon Kind="activity" Width="24" Height="24" HorizontalAlignment="Center" /><TextBlock Text="Activity" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsGitHubActivityPage}" Command="{Binding ShowGitHubActivityCommand}"><StackPanel Spacing="7"><controls:NavigationIcon Kind="github" Width="24" Height="24" HorizontalAlignment="Center" /><TextBlock Text="GitHub" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsAutomationsPage}" Command="{Binding ShowAutomationsCommand}"><StackPanel Spacing="7"><controls:NavigationIcon Kind="schedules" Width="24" Height="24" HorizontalAlignment="Center" /><TextBlock Text="Automations" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsStoragePage}" Command="{Binding ShowStorageCommand}"><StackPanel Spacing="7"><controls:NavigationIcon Kind="storage" Width="24" Height="24" HorizontalAlignment="Center" /><TextBlock Text="Storage" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsConnectionsPage}" Command="{Binding ShowConnectionsCommand}"><StackPanel Spacing="7"><controls:NavigationIcon Kind="connections" Width="24" Height="24" HorizontalAlignment="Center" /><TextBlock Text="Connections" HorizontalAlignment="Center" /></StackPanel></Button>
          <Button Classes="rail" Classes.selected="{Binding IsSettingsPage}" Command="{Binding ShowSettingsCommand}"><StackPanel Spacing="7"><controls:NavigationIcon Kind="settings" Width="24" Height="24" HorizontalAlignment="Center" /><TextBlock Text="Settings" HorizontalAlignment="Center" /></StackPanel></Button>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#FBFCFF" BorderBrush="#DDE5EF" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="58,42,36,*,28">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="17,8">
            <TextBlock Text="Projects" FontSize="20" FontWeight="SemiBold" Foreground="#101B30" VerticalAlignment="Center" />
            <Button Grid.Column="1" ToolTip.Tip="Choose workspace folder" Click="ChooseWorkspace" Classes="toolbar"><controls:NavigationIcon Kind="plus" Width="18" Height="18" Ink="#25354E" /></Button>
            <Button Grid.Column="2" ToolTip.Tip="Refresh repositories" Command="{Binding RefreshCommand}" Classes="toolbar"><controls:NavigationIcon Kind="refresh" Width="18" Height="18" Ink="#25354E" /></Button>
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding Filter}" PlaceholderText="Filter projects…" Margin="16,0,16,7" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="16,0,16,5">
            <Button Content="Favorites" Classes="chip" Classes.active="{Binding FavoritesOnly}" Command="{Binding ShowFavoriteProjectsCommand}" />
            <Button Content="All" Classes="chip" Classes.active="{Binding AllProjects}" Command="{Binding ShowAllProjectsCommand}" />
          </StackPanel>
          <TreeView Grid.Row="3" x:Name="ProjectTree" ItemsSource="{Binding ExplorerRoots}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Background="Transparent" Margin="6,0" ItemContainerTheme="{StaticResource WorkspaceTreeItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:ExplorerNode" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="20,*,Auto,Auto" ColumnSpacing="7" Height="30" ToolTip.Tip="{Binding Path}">
                  <controls:ProjectIcon Kind="{Binding IconKind}" Width="20" Height="20" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding NodeWeight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" FontSize="12" VerticalAlignment="Center" MaxWidth="70" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" IsVisible="{Binding HasStatusMarker}">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMarker}" Foreground="{Binding StatusBrush}" FontSize="12" MaxWidth="64" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <Border Grid.Row="4" BorderBrush="#DDE5EF" BorderThickness="0,1,0,0" Padding="16,4">
            <TextBlock Text="{Binding RepositoryCount}" Classes="muted" FontSize="12" />
          </Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="2" ResizeDirection="Columns" Background="#E5EBF4" />
      <Grid Grid.Column="3" Background="White">
        <Grid.RowDefinitions><RowDefinition Height="43" /><RowDefinition Height="93" /><RowDefinition Height="*" /><RowDefinition Height="{Binding OutputPaneHeight}" /></Grid.RowDefinitions>
        <Border Background="#EFF4FB" BorderBrush="#DDE5EF" BorderThickness="0,0,0,1">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
              <Button Content="Workspace" Command="{Binding ShowWorkspaceCommand}" Classes="documentTab" Classes.active="{Binding IsWorkspaceTab}" />
              <ItemsControl ItemsSource="{Binding Documents}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WorkspaceDocumentViewModel">
                    <Border Classes="document" Classes.active="{Binding IsActive}" ToolTip.Tip="{Binding Location}">
                      <StackPanel Orientation="Horizontal">
                        <Button Classes="documentTab" Command="{ReflectionBinding DataContext.SelectDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                          <TextBlock Text="{Binding Caption}" MaxWidth="230" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button Content="×" Classes="documentClose" ToolTip.Tip="Close document" Command="{ReflectionBinding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE5EF" BorderThickness="0,0,0,1" Padding="22,14" IsVisible="{Binding !IsWorkspaceUtilityPage}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <TextBlock Text="{Binding ProjectName}" Classes="heading" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Branch}" Foreground="#0865FF" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel ItemSpacing="20" LineSpacing="8">
              <Button Content="Overview" Command="{Binding ShowOverviewCommand}" Classes="pageTab" Classes.active="{Binding IsOverviewPage}" />
              <Button Content="Files" Command="{Binding ShowFilesCommand}" Classes="pageTab" Classes.active="{Binding IsFilesPage}" />
              <Button Content="Changes" Command="{Binding ShowChangesCommand}" Classes="pageTab" Classes.active="{Binding IsChangesPage}" />
              <Button Content="History" Command="{Binding ShowHistoryCommand}" Classes="pageTab" Classes.active="{Binding IsHistoryPage}" />
              <Button Content="Build &amp; Run" Command="{Binding ShowBuildCommand}" Classes="pageTab" Classes.active="{Binding IsBuildPage}" />
              <Button Content="GitHub" Command="{Binding ShowGitHubCommand}" Classes="pageTab" Classes.active="{Binding IsGitHubPage}" />
              <Button Content="Releases" Command="{Binding ShowReleaseCommand}" Classes="pageTab" Classes.active="{Binding IsReleasePage}" />
              <Button Content="{Binding FavoriteActionLabel}" Command="{Binding ToggleFavoriteCommand}" IsEnabled="{Binding HasActiveProject}" Classes="pageTab" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <ContentControl Grid.Row="2" IsVisible="{Binding IsChangesPage}"><views:GitChangesView DataContext="{Binding Changes}" /></ContentControl>
        <ContentControl Grid.Row="2" IsVisible="{Binding IsHistoryPage}"><views:ProjectHistoryView DataContext="{Binding History}" /></ContentControl>
        <ContentControl Grid.Row="2" IsVisible="{Binding IsGitHubPage}"><views:GitHubView DataContext="{Binding GitHub}" /></ContentControl>
        <ContentControl Grid.Row="2" IsVisible="{Binding IsReleasePage}"><views:ReleaseView DataContext="{Binding Release}" /></ContentControl>
        <views:FilesView Grid.Row="2" IsVisible="{Binding IsFilesPage}" />
        <views:ProjectOverviewView x:Name="ProjectOverviewPage" Grid.Row="2" IsVisible="{ReflectionBinding DataContext.IsOverviewPage, RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding Overview}" />
        <ContentControl Grid.Row="2" IsVisible="{Binding IsBuildPage}"><views:BuildView DataContext="{Binding Build}" /></ContentControl>
        <views:ActivityView x:Name="ActivityPage" Grid.Row="1" Grid.RowSpan="2" IsVisible="{ReflectionBinding DataContext.IsActivityPage, RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding Activity}" />
        <views:StorageView Grid.Row="1" Grid.RowSpan="2" IsVisible="{ReflectionBinding DataContext.IsStoragePage, RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding Storage}" />
        <views:AutomationsView x:Name="AutomationsPage" Grid.Row="1" Grid.RowSpan="2" IsVisible="{ReflectionBinding DataContext.IsAutomationsPage, RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding Automations}" />
        <views:ConnectionsView x:Name="ConnectionsPage" Grid.Row="1" Grid.RowSpan="2" IsVisible="{ReflectionBinding DataContext.IsConnectionsPage, RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding Connections}" />
        <views:SettingsView x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="2" IsVisible="{ReflectionBinding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding Settings}" />
        <Border Grid.Row="3" Background="#102236" BorderBrush="#2D4157" BorderThickness="0,1,0,0">
          <Grid RowDefinitions="38,*">
            <Border BorderBrush="#2D4157" BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="9" Margin="17,10"><controls:NavigationIcon Kind="output" Width="17" Height="17" Ink="#80B8FF" /><TextBlock Text="Output" Foreground="#F2F7FF" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" Margin="17,5,17,12" HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Text="{Binding DisplayedOutput}" Foreground="#D7E7F8" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" />
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Column="4" x:Name="ContextPanel" Background="White" BorderBrush="#DDE5EF" BorderThickness="1,0,0,0" Padding="20,23">
        <Grid>
          <Grid IsVisible="{Binding !IsWorkspaceUtilityPage}">
            <StackPanel Spacing="18" IsVisible="{Binding !IsChangesPage}">
            <TextBlock Text="Selected working copy" FontWeight="SemiBold" FontSize="16" />
            <Button Content="{Binding FavoriteActionLabel}" Command="{Binding ToggleFavoriteCommand}" IsEnabled="{Binding HasActiveProject}" />
            <TextBlock Text="{Binding StateError}" IsVisible="{Binding HasStateError}" TextWrapping="Wrap" Foreground="#B45309" />
            <TextBlock Text="Working copy" Classes="muted" />
            <TextBlock Text="{Binding Branch}" />
            <TextBlock Text="Git state" Classes="muted" />
            <TextBlock Text="{Binding GitSummary}" TextWrapping="Wrap" />
            <TextBlock Text="Selection" Classes="muted" />
            <TextBox Text="{Binding SelectedPath}" IsReadOnly="True" TextWrapping="Wrap" Height="52" FontSize="12"
                     BorderThickness="0" Background="Transparent" Padding="0" ToolTip.Tip="Select and copy the full path" />
            <TextBlock Text="Local discovery" Classes="muted" />
            <TextBlock Text="Build outputs and package caches are hidden in the explorer." TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer IsVisible="{Binding IsChangesPage}">
            <StackPanel Spacing="12" DataContext="{Binding Changes}">
              <TextBlock Text="Selected change" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="Select a file to inspect its Git state and stage it." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasSelection}" />
              <StackPanel Spacing="12" IsVisible="{Binding HasSelection}">
                <TextBlock Text="{Binding Selected.Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Border BorderBrush="#DDE5EF" BorderThickness="0,1,0,0" />
                <Grid ColumnDefinitions="85,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="8">
                  <TextBlock Text="State" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding Selected.State}" />
                  <TextBlock Grid.Row="1" Text="Change" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.ChangeType}" />
                  <TextBlock Grid.Row="2" Text="Branch" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Snapshot.BranchDisplay}" TextWrapping="Wrap" />
                </Grid>
                <Button Content="Stage selected" Command="{Binding StageCommand}" IsEnabled="{Binding CanStage}" IsVisible="{Binding CanStage}" />
                <Button Content="Unstage selected" Command="{Binding UnstageCommand}" IsEnabled="{Binding CanUnstage}" IsVisible="{Binding CanUnstage}" />
                <TextBlock Text="The patch and commit form remain in Changes." Classes="muted" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
              <Border Background="#F3F7FD" BorderBrush="#D9E3F0" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Spacing="4">
                  <TextBlock Text="Working-copy summary" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Snapshot.StatusSummary}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
            </ScrollViewer>
          </Grid>
          <ScrollViewer IsVisible="{Binding IsActivityPage}">
            <StackPanel Spacing="14" DataContext="{Binding Activity}">
              <TextBlock Text="Activity evidence" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="{Binding SelectedEntry.Project}" Foreground="#0865FF" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedEntry.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedEntry.State}" />
              <TextBlock Text="Detail" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.Detail}" TextWrapping="Wrap" />
              <TextBlock Text="Provider" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.Provider}" />
              <TextBlock Text="Observed" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.ObservedDisplay}" />
              <TextBlock Text="Source" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.SourceDisplay}" FontSize="11" TextWrapping="Wrap" />
              <Button Content="Open source" Command="{Binding OpenSelectedCommand}" IsEnabled="{Binding CanOpenSelected}" />
              <Button Content="Hide for this session" Command="{Binding MuteSelectedCommand}" IsEnabled="{Binding CanMuteSelected}" />
              <Button Content="Restore hidden items" Command="{Binding RestoreMutedCommand}" IsVisible="{Binding HasMuted}" />
              <Border Background="#FFF7E6" BorderBrush="#F4C96B" BorderThickness="1" CornerRadius="6" Padding="10">
                <TextBlock Text="Hiding changes only this local view. It never closes, resolves, reruns or acknowledges provider content." TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer IsVisible="{Binding IsStoragePage}">
            <StackPanel Spacing="12" DataContext="{Binding Storage}">
              <TextBlock Text="Review evidence" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="Select a working copy to inspect its local evidence." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasSelection}" />
              <StackPanel Spacing="12" IsVisible="{Binding HasSelection}">
                <TextBlock Text="{Binding SelectedEntry.DisplayName}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <TextBox Text="{Binding SelectedEntry.Path}" IsReadOnly="True" TextWrapping="Wrap" Height="52" FontSize="12"
                         BorderThickness="0" Background="Transparent" Padding="0" ToolTip.Tip="Select and copy the full path" />
                <Border BorderBrush="#DDE5EF" BorderThickness="0,1,0,0" />
                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="13" ColumnSpacing="8">
                  <TextBlock Text="Local changes" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <controls:StatusIcon IsError="{Binding SelectedEntry.IsBroken}" IsWarning="{Binding SelectedEntry.IsChanged}" IsSuccess="{Binding !SelectedEntry.IsBroken}" Width="16" Height="16" />
                    <TextBlock Text="{Binding SelectedEntry.LocalStateDisplay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="Ancestry" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEntry.AncestryDisplay}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" Text="Remote / PR" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="Not checked" Foreground="#B45309" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Text="Active use" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="Not checked" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="4" Text="Retained artifacts" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="Not checked" TextWrapping="Wrap" />
                </Grid>
                <Border Background="#FFF7E6" BorderBrush="#F4C96B" BorderThickness="1" CornerRadius="6" Padding="10">
                  <TextBlock Text="Candidate rows are local evidence. Use Review removal to refresh remote, Studio-use and retained-content checks." TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding SelectedEntry.Warning}" Foreground="#BA2737" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer IsVisible="{Binding IsAutomationsPage}">
            <StackPanel Spacing="14" DataContext="{Binding Automations}">
              <TextBlock Text="Automation evidence" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="{Binding SelectedEntry.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedEntry.Provider}" Foreground="#0865FF" />
              <TextBlock Text="Project / scope" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.ProjectDisplay}" TextWrapping="Wrap" />
              <TextBlock Text="Schedule" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.Schedule}" TextWrapping="Wrap" />
              <TextBlock Text="Last observation" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.LastRunDisplay}" />
              <TextBlock Text="{Binding SelectedEntry.LastResult}" TextWrapping="Wrap" />
              <TextBlock Text="Source" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.SourcePath}" FontSize="11" TextWrapping="Wrap" />
              <Border Background="#EFF5FF" BorderBrush="#A9C8FF" BorderThickness="1" CornerRadius="6" Padding="10">
                <TextBlock Text="{Binding SelectedEntry.Detail}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer IsVisible="{Binding IsConnectionsPage}">
            <StackPanel Spacing="14" DataContext="{Binding Connections}">
              <TextBlock Text="Connection evidence" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="{Binding SelectedEntry.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedEntry.State}" Foreground="#0865FF" />
              <TextBlock Text="Endpoint" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.Endpoint}" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="Credential reference" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.CredentialReference}" TextWrapping="Wrap" />
              <TextBlock Text="Observed capabilities" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.CapabilityDisplay}" TextWrapping="Wrap" />
              <TextBlock Text="Last verified" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.VerifiedDisplay}" />
              <TextBlock Text="Owner" Classes="muted" />
              <TextBlock Text="{Binding SelectedEntry.Owner}" FontSize="11" TextWrapping="Wrap" />
              <Border Background="#EFF5FF" BorderBrush="#A9C8FF" BorderThickness="1" CornerRadius="6" Padding="10">
                <TextBlock Text="{Binding SelectedEntry.Evidence}" TextWrapping="Wrap" />
              </Border>
              <Border Background="#EFF7F1" BorderBrush="#A9D7B4" BorderThickness="1" CornerRadius="6" Padding="10">
                <TextBlock Text="No secret value is loaded into the Connections page." TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer IsVisible="{Binding IsSettingsPage}">
            <StackPanel Spacing="14" DataContext="{Binding Settings}">
              <TextBlock Text="Settings context" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="{Binding Section}" Foreground="#0865FF" />
              <TextBlock Text="Current workspace" Classes="muted" />
              <TextBlock Text="{Binding WorkspaceRoot}" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="Local configuration" Classes="muted" />
              <TextBlock Text="{Binding ConfigurationPath}" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="Unsaved changes" Classes="muted" />
              <TextBlock Text="{Binding IsDirty}" />
              <Button Content="Save settings" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" IsVisible="{Binding IsEditableSection}" />
              <Button Content="Reset to defaults" Command="{Binding ResetCommand}" IsEnabled="{Binding !IsSaving}" IsVisible="{Binding IsEditableSection}" />
              <Border Background="#EFF7F1" BorderBrush="#A9D7B4" BorderThickness="1" CornerRadius="6" Padding="10">
                <TextBlock Text="This file is machine-local. It contains no credential values." TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#F5F8FD" BorderBrush="#DDE5EF" BorderThickness="0,1,0,0" Padding="15,5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding DisplayedStatus}" ToolTip.Tip="{Binding DisplayedStatus}" FontSize="12" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="Avalonia · Local workspace" Classes="muted" FontSize="12" />
      </Grid>
    </Border>
  </Grid>
</Window>
