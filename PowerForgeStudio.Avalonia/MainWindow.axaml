<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PowerForgeStudio.Avalonia.ViewModels"
        xmlns:hub="using:PowerForgeStudio.Domain.Hub"
        xmlns:controls="using:PowerForgeStudio.Avalonia.Controls"
        x:Class="PowerForgeStudio.Avalonia.MainWindow" x:DataType="vm:WorkspaceViewModel"
        Width="1600" Height="1000" MinWidth="1050" MinHeight="700" Title="PowerForge Studio">
  <Grid RowDefinitions="48,*,30">
    <Border Grid.Row="0">
      <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#193958" /><GradientStop Color="#061A34" Offset="1" /></LinearGradientBrush></Border.Background>
      <Grid ColumnDefinitions="360,*,280" Margin="22,0">
        <TextBlock Text="PowerForge Studio" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Filter}" PlaceholderText="Find a project…" MaxWidth="550" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#EAF0F8" />
        <TextBlock Grid.Column="2" Text="Local workspace" Foreground="#D6E4F7" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="70,326,5,*,280">
      <Border Background="#0B2745">
        <StackPanel Spacing="4" Margin="0,10">
          <Button Classes="rail" Content="Projects" />
          <Button Classes="rail" Content="Activity" IsEnabled="False" />
          <Button Classes="rail" Content="GitHub" IsEnabled="False" />
          <Button Classes="rail" Content="Schedules" IsEnabled="False" />
          <Button Classes="rail" Content="Storage" IsEnabled="False" />
          <Button Classes="rail" Content="Connections" IsEnabled="False" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#FBFCFF" BorderBrush="#DDE5EF" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="58,42,36,*,28">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="17,8">
            <TextBlock Text="Projects" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="+" ToolTip.Tip="Choose workspace folder" Click="ChooseWorkspace" Padding="8,2" BorderThickness="0" />
            <Button Grid.Column="2" Content="↻" ToolTip.Tip="Refresh repositories" Command="{Binding RefreshCommand}" Padding="8,2" BorderThickness="0" />
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding Filter}" PlaceholderText="Filter projects…" Margin="16,0,16,7" />
          <TextBlock Grid.Row="2" Text="All projects" Foreground="#0865FF" FontWeight="SemiBold" Margin="19,6" />
          <TreeView Grid.Row="3" x:Name="ProjectTree" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Background="Transparent" Margin="5,0">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:ExplorerNode" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="8" Height="30" ToolTip.Tip="{Binding Path}">
                  <controls:ProjectIcon Kind="{Binding Kind}" Width="20" Height="20" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="5,0" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <Border Grid.Row="4" BorderBrush="#DDE5EF" BorderThickness="0,1,0,0" Padding="16,4">
            <TextBlock Text="{Binding RepositoryCount}" Classes="muted" FontSize="12" />
          </Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="2" ResizeDirection="Columns" Background="#E5EBF4" />
      <Grid Grid.Column="3" RowDefinitions="43,93,*,170">
        <Border Background="#EFF4FB" BorderBrush="#DDE5EF" BorderThickness="0,0,0,1" Padding="18,10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:ProjectIcon Kind="folder" Width="20" Height="20" />
            <TextBlock Text="{Binding ProjectName}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE5EF" BorderThickness="0,0,0,1" Padding="22,14">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <TextBlock Text="{Binding ProjectName}" Classes="heading" />
              <TextBlock Text="{Binding Branch}" Foreground="#0865FF" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="25">
              <TextBlock Text="Files" Foreground="#0865FF" FontWeight="SemiBold" />
              <TextBlock Text="Changes" Classes="muted" />
              <TextBlock Text="Build &amp; Run" Classes="muted" />
              <TextBlock Text="Releases" Classes="muted" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" Margin="22,18">
          <TextBlock Text="Files" Classes="heading" />
          <TextBlock Grid.Row="1" Text="{Binding SelectedPath}" Classes="muted" TextTrimming="CharacterEllipsis" Margin="0,9,0,18" />
          <Grid Grid.Row="2" ColumnDefinitions="0.85*,14,1.15*">
            <Border Classes="card">
              <Grid RowDefinitions="42,*">
                <TextBlock Text="Name" Margin="15,12" FontWeight="SemiBold" />
                <ListBox Grid.Row="1" x:Name="FileList" ItemsSource="{Binding Files}" DoubleTapped="OpenFile" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="hub:FileSystemEntry">
                      <Grid ColumnDefinitions="*,90" ToolTip.Tip="{Binding FullPath}">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Extension}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border Grid.Column="2" Classes="card">
              <Grid RowDefinitions="42,*">
                <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" Margin="15,12" />
                <TextBox Grid.Row="1" Text="{Binding Preview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Cascadia Code, Consolas, monospace" FontSize="13" BorderThickness="0" Padding="15"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
        <Border Grid.Row="3" Background="#0D2132">
          <Grid RowDefinitions="38,*">
            <TextBlock Text="Output" Foreground="#E6F0FF" Margin="17,10" />
            <ScrollViewer Grid.Row="1" Margin="17,5,17,12">
              <SelectableTextBlock Text="{Binding Output}" Foreground="#D7E7F8" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" />
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Column="4" Background="White" BorderBrush="#DDE5EF" BorderThickness="1,0,0,0" Padding="20,23">
        <StackPanel Spacing="18">
          <TextBlock Text="Context" FontWeight="SemiBold" FontSize="16" />
          <TextBlock Text="Working copy" Classes="muted" />
          <TextBlock Text="{Binding Branch}" />
          <TextBlock Text="Git state" Classes="muted" />
          <TextBlock Text="{Binding GitSummary}" TextWrapping="Wrap" />
          <TextBlock Text="Selection" Classes="muted" />
          <TextBlock Text="{Binding SelectedPath}" TextWrapping="Wrap" FontSize="12" />
          <TextBlock Text="Local discovery" Classes="muted" />
          <TextBlock Text="Build outputs and package caches are hidden in the explorer." TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#F5F8FD" BorderBrush="#DDE5EF" BorderThickness="0,1,0,0" Padding="15,5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="Avalonia · Local workspace" Classes="muted" FontSize="12" />
      </Grid>
    </Border>
  </Grid>
</Window>

