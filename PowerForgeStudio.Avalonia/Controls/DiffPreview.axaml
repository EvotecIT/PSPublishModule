<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PowerForgeStudio.Avalonia.Controls"
             x:Class="PowerForgeStudio.Avalonia.Controls.DiffPreview" x:Name="DiffRoot">
  <Grid RowDefinitions="Auto,*" Background="#F7F9FC">
    <Grid ColumnDefinitions="*,Auto" Margin="10,6" ColumnSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Patch" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Text="Styled preview shortened; Raw shows all loaded patch text."
                   IsVisible="{ReflectionBinding #DiffRoot.IsTruncated}" Foreground="#98620C" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
      <ToggleButton Grid.Column="1" Content="Raw" IsChecked="{ReflectionBinding #DiffRoot.IsRaw, Mode=TwoWay}"
                    ToolTip.Tip="Show all loaded patch text as selectable plain text" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  IsVisible="{ReflectionBinding #DiffRoot.ShowFormatted}">
      <ItemsControl ItemsSource="{ReflectionBinding #DiffRoot.Lines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="controls:DiffPreviewLine">
            <Border Background="{Binding Background}" Padding="9,1">
              <SelectableTextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                   FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" TextWrapping="NoWrap" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  IsVisible="{ReflectionBinding #DiffRoot.IsRaw}">
      <SelectableTextBlock Text="{ReflectionBinding #DiffRoot.Text}" Margin="10,4" Foreground="#223047"
                           FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" />
    </ScrollViewer>
  </Grid>
</UserControl>
